# Server
APP_ENV=development
PORT=8080
FRONTEND_URL=https://thevhomes.com

# Database (Render PostgreSQL connection string)
DATABASE_URL=postgres://user:password@host:5432/thevhomes?sslmode=require

# Redis (optional, for caching + multi-instance WebSocket fan-out)
REDIS_URL=

# JWT
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string

# Cloudflare R2 (S3-compatible object storage for images/videos)
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_ENDPOINT=

# Payments
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=

# Email (transactional notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Third-party APIs
GOOGLE_MAPS_API_KEY=
OPENAI_API_KEY=
