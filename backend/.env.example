# Server
APP_ENV=development
PORT=8080
FRONTEND_URL=https://thevhomes.com

# Database (Render PostgreSQL connection string)
DATABASE_URL=postgres://user:password@host:5432/thevhomes?sslmode=require

# Redis (optional, for caching + multi-instance WebSocket fan-out)
REDIS_URL=

# JWT
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string

# Cloudflare R2 (S3-compatible object storage for images/videos/3D tour scenes)
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_ENDPOINT=

# Payments (Paystack / Flutterwave) — booking fees + paid viewing services
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=

# Email (transactional notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=TheVHomes <no-reply@thevhomes.com>

# Third-party APIs
GOOGLE_MAPS_API_KEY=
OPENAI_API_KEY=

# Google OAuth 2.0 ("Continue/Sign in/Sign up with Google")
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=https://api.thevhomes.com/api/v1/auth/google/callback

# VerifyMe (Nigerian NIN identity verification) — leave unset to run in
# local "sandbox mode" (any well-formed 11-digit NIN auto-verifies), which
# must NEVER be used in production.
VERIFYME_API_KEY=
VERIFYME_BASE_URL=https://vapi.verifyme.ng/v1

# AES-256 key used to encrypt NIN and other sensitive PII at rest.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# Permanent agent ID numbering, e.g. TVH-AGT -> TVH-AGT-000001
AGENT_NUMBER_PREFIX=TVH-AGT

# QR code rendering service for viewing tickets (defaults to a public API;
# self-host for production if you'd rather not depend on a third party).
QR_CODE_SERVICE_BASE_URL=https://api.qrserver.com/v1/create-qr-code/
