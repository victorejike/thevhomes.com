# Base URL of the deployed Go API (Render), including /api/v1
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Optional: direct URL to a hosted hero background video (mp4). If unset,
# a real stock property video (Mixkit CDN) is used by default so the hero
# always plays a real video. Set this once TheVHomes' own branded footage is
# uploaded to Cloudflare R2.
NEXT_PUBLIC_HERO_VIDEO_URL=

# Optional: background video (mp4) for the "Ready to Find Your Perfect
# Property?" CTA section near the footer. Defaults to a different real
# stock property video so it doesn't repeat the hero footage.
NEXT_PUBLIC_CTA_VIDEO_URL=

# Optional: enables real Google Maps embeds on property detail pages.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
